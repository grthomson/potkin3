/-!
# Formula signatures

Potkin formulas are freely generated by atoms and operation symbols indexed
by arity.  No proof-theoretic behaviour is attached to a symbol here.
-/

namespace Potkin

universe u v

/-- A formula signature with operation symbols indexed by their arity. -/
structure Signature where
  Atom : Type u
  Op : Nat -> Type v

/-- Formulae freely generated by a signature. -/
inductive Formula (sigma : Signature.{u, v}) : Type (max u v) where
  | atom : sigma.Atom -> Formula sigma
  | app {n : Nat} : sigma.Op n -> (Fin n -> Formula sigma) -> Formula sigma

namespace Formula

variable {sigma : Signature.{u, v}}

/-- Apply a nullary operation symbol. -/
def app0 (c : sigma.Op 0) : Formula sigma :=
  .app c Fin.elim0

/-- Apply a unary operation symbol. -/
def app1 (c : sigma.Op 1) (A : Formula sigma) : Formula sigma :=
  .app c (fun _ => A)

/-- Apply a binary operation symbol, retaining the ordered argument slots. -/
def app2 (c : sigma.Op 2) (A B : Formula sigma) : Formula sigma :=
  .app c (fun i => if i.1 = 0 then A else B)

end Formula

end Potkin
